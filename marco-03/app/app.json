{
  "expo": {
    "name": "Presença M3",
    "slug": "presenca-m3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.ufg.presenca.m3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.ufg.presenca.m3"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera é usada só para ler o QR da turma."
        }
      ],
      "expo-notifications",
      [
        "react-native-ble-manager",
        {
          "neverForLocation": false,
          "isBleRequired": true
        }
      ],
      "./plugins/ble-sem-never-for-location.js"
    ],
    "scheme": "presenca-m3",
    "experiments": {
      "typedRoutes": true
    }
  }
}
